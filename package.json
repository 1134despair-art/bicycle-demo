{
  "name": "bicycle-demo",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:prod": "npm run build",
    "preview": "vite preview",
    "android:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-android-assets.ps1",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.4",
    "@unocss/preset-attributify": "66.4.2",
    "@unocss/preset-icons": "66.4.2",
    "@unocss/preset-uno": "66.4.2",
    "@unocss/reset": "66.4.2",
    "@unocss/vite": "66.4.2",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "unocss": "66.4.2",
    "vue": "^3.5.39",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@types/node": "^20.17.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "rollup": "4.34.9"
  }
}
